    "Rows": {
      "SpawnPoint_1": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_1_TextData",
          "SourceString": "小高い丘の上。\r\n見晴らしがよく資源も豊富なため、\r\n初めてプレイする人におすすめ。",
          "LocalizedString": "小高い丘の上。\r\n見晴らしがよく資源も豊富なため、\r\n初めてプレイする人におすすめ。"
        }
      },
      "SpawnPoint_1_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_1_Title_TextData",
          "SourceString": "風立ちの島 始まりの丘",
          "LocalizedString": "風立ちの島 始まりの丘"
        }
      },
      "SpawnPoint_2": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_2_TextData",
          "SourceString": "海辺の砂浜。水生のパルが多い。\r\n木は少ないが、パルはそこそこ生息している。",
          "LocalizedString": "海辺の砂浜。水生のパルが多い。\r\n木は少ないが、パルはそこそこ生息している。"
        }
      },
      "SpawnPoint_2_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_2_Title_TextData",
          "SourceString": "風立ちの島 飛び魚海岸",
          "LocalizedString": "風立ちの島 飛び魚海岸"
        }
      },
      "SpawnPoint_3": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_3_TextData",
          "SourceString": "岩礁が広がる海岸。\r\n資源やパルの量は平均的。\r\n少し岩がちだが、広めの土地を確保できる。",
          "LocalizedString": "岩礁が広がる海岸。\r\n資源やパルの量は平均的。\r\n少し岩がちだが、広めの土地を確保できる。"
        }
      },
      "SpawnPoint_3_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_3_Title_TextData",
          "SourceString": "潮風諸島 岩礁",
          "LocalizedString": "潮風諸島 岩礁"
        }
      },
      "SpawnPoint_4": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_4_TextData",
          "SourceString": "潮風が吹き抜ける島。\r\n火山に近く、温暖な気候で住みやすい。\r\n周辺の​島にも​渡りやすく、様々な冒険が楽しめる。",
          "LocalizedString": "潮風が吹き抜ける島。\r\n火山に近く、温暖な気候で住みやすい。\r\n周辺の​島にも​渡りやすく、様々な冒険が楽しめる。"
        }
      },
      "SpawnPoint_4_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_4_Title_TextData",
          "SourceString": "潮風諸島 漂流者の浜",
          "LocalizedString": "潮風諸島 漂流者の浜"
        }
      },
      "SpawnPoint_5": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_5_TextData",
          "SourceString": "人が​住んでいる​気配の​ない島。​\u2028\r\n自然の​恵みも​乏しく、​\r\n居住には​適していないようだ。",
          "LocalizedString": "人が​住んでいる​気配の​ない島。​\u2028\r\n自然の​恵みも​乏しく、​\r\n居住には​適していないようだ。"
        }
      },
      "SpawnPoint_5_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_5_Title_TextData",
          "SourceString": "静寂の島",
          "LocalizedString": "静寂の島"
        }
      },
      "SpawnPoint_6": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_6_TextData",
          "SourceString": "高低差の​ある​地形と​木々に​囲まれた​静かな島。​\r\n資源や​パルの​数は​限られており、​\r\nこの​地に​根を​下ろす者は​少ない。",
          "LocalizedString": "高低差の​ある​地形と​木々に​囲まれた​静かな島。​\r\n資源や​パルの​数は​限られており、​\r\nこの​地に​根を​下ろす者は​少ない。"
        }
      },
      "SpawnPoint_6_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_6_Title_TextData",
          "SourceString": "さざめきの島",
          "LocalizedString": "さざめきの島"
        }
      },
      "SpawnPoint_7": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_7_TextData",
          "SourceString": "東に位置する荒れた島。\r\n大陸の端にあり、誰も開拓しようとしない。\r\n慣れてない者が住むには、少し難しい。",
          "LocalizedString": "東に位置する荒れた島。\r\n大陸の端にあり、誰も開拓しようとしない。\r\n慣れてない者が住むには、少し難しい。"
        }
      },
      "SpawnPoint_7_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_7_Title_TextData",
          "SourceString": "東の荒れ島",
          "LocalizedString": "東の荒れ島"
        }
      },
      "SpawnPoint_8": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_8_TextData",
          "SourceString": "湿地帯が広がっている島。\r\n適度な湿度からベリーがたくさん生えている。\r\n様々な​種類の​パルが​生息している。​",
          "LocalizedString": "湿地帯が広がっている島。\r\n適度な湿度からベリーがたくさん生えている。\r\n様々な​種類の​パルが​生息している。​"
        }
      },
      "SpawnPoint_8_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_8_Title_TextData",
          "SourceString": "湿原の島",
